# ---- Cloudflare Turnstile -------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Seed pipeline (scripts/, never used by the app) ----------------------
ANTHROPIC_API_KEY=

# ---- Admin ----------------------------------------------------------------
ADMIN_PASSWORD=
