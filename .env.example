# ---- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Maps and search ------------------------------------------------------
# Nothing goes here. The basemap is OpenFreeMap and place search is Photon,
# both key-free. See design/README.md.

# ---- Cloudflare Turnstile -------------------------------------------------
# Leave empty and the check is skipped, which is fine locally and not fine in
# public.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Seed pipeline (scripts/, never used by the app) ----------------------
# Only needed to RE-run normalisation after a prompt change. The full corpus is
# already cached, so scripts/02_normalize.py --offline needs no key.
ANTHROPIC_API_KEY=

# ---- Admin ----------------------------------------------------------------
ADMIN_PASSWORD=

# ---- Reporting ------------------------------------------------------------
# Salt for the pseudonymous reporter hash. Any long random string; changing it
# resets the "independent confirmations" count, so set it once and leave it.
IP_HASH_SALT=
